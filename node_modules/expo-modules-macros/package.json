{
  "name": "expo-modules-macros",
  "version": "0.22.0",
  "description": "Swift macro plugin for Expo modules",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "homepage": "https://github.com/expo/expo-modules-macros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/expo-modules-macros.git"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:ts": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "swift:format": "node scripts/swift-format.js",
    "swift:lint": "node scripts/swift-format.js --lint",
    "prepublishOnly": "npm run build:ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@expo/modules-macros-linux-arm64": "0.22.0",
    "@expo/modules-macros-linux-x64": "0.22.0",
    "@expo/modules-macros-win32-arm64": "0.22.0",
    "@expo/modules-macros-win32-x64": "0.22.0"
  }
}
